<#@ template hostspecific="true" #>
<#@ output extension="cs" #>
<#@ import namespace="System.IO" #>
// <auto-generated/>
#nullable enable

<#
  string original_path = this.Host.ResolvePath("Main.cs");
  string contents = File.ReadAllText(original_path);

  string parms = @"
  [TypeMarshalOverload(typeof(ReadOnlySpan<>), typeof(List<>), typeof(CollectionsMarshal),
      nameof(CollectionsMarshal.AsSpan))]
  [TypeMarshalOverload(typeof(ReadOnlySpan<>), typeof(ImmutableArray<>), typeof(ImmutableArray<>),
      ""AsSpan()"")]
  public static TotalStatistics Calculate<TVal, TCnt>(
      this in ReadOnlySpan<KeyValuePair<TVal, TCnt>> values)
      where TVal : unmanaged, IConvertible
      where TCnt : unmanaged, IConvertible {
    int length = values.Length;
  ";

  string loop = @"
      for (int i = 0; i < length; ++i) {
        ulong count  = values[i].Value.ToUInt64(null);
        if (count == 0) {
          ++skip_cnt;
          continue;
        }

        double value = values[i].Key.ToDouble(null);
  ";

  int a_first = contents.IndexOf("// <!-- A");
  int a_last = contents.IndexOf("// A -->");

  int b_first = contents.IndexOf("// <!-- B");
  int b_last = contents.IndexOf("// B -->");

  Write(contents.Substring(0, a_first));
  Write(parms);
  Write(contents.Substring(a_last, b_first - a_last));
  Write(loop);
  Write(contents.Substring(b_last));
#>
