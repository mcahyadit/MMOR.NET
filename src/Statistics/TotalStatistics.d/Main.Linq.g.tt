<#@ template hostspecific="true" #>
<#@ output extension="cs" #>
<#@ import namespace="System.IO" #>
// <auto-generated/>
#nullable enable

<#
  string original_path = this.Host.ResolvePath("Main.cs");
  string contents = File.ReadAllText(original_path);

  string parms = @"
  public static TotalStatistics Calculate(in IEnumerable<double> values,
    in IEnumerable<ulong> counts, int length) {
  ";

  string loop = @"
      int i = 0;
      using var val_enum = values.GetEnumerator();
      using var cnt_enum = counts.GetEnumerator();
      while (val_enum.MoveNext() && cnt_enum.MoveNext()) {
        ++i;
        double value = val_enum.Current;
        ulong count  = cnt_enum.Current;
        if (count == 0) {
          ++skip_cnt;
          continue;
        }
  ";

  int a_first = contents.IndexOf("// <!-- A");
  int a_last = contents.IndexOf("// A -->");

  int b_first = contents.IndexOf("// <!-- B");
  int b_last = contents.IndexOf("// B -->");

  Write("using System.Linq;\n");
  Write(contents.Substring(0, a_first));
  Write(parms);
  Write(contents.Substring(a_last, b_first - a_last));
  Write(loop);
  Write(contents.Substring(b_last));
#>
