<#@ template hostspecific="true" #>
<#@ output extension="cs" #>
<#@ import namespace="System.IO" #>
// <auto-generated/>

<#
  string original_path = this.Host.ResolvePath("AddAssign.cs");
  string[] SupportedTypes = new[] {
    "long",
    "uint",
    "int",
    "float",
    "double",
  };
  string contents = File.ReadAllText(original_path);

  int first = contents.IndexOf('{') + 1;
  int last = contents.LastIndexOf('}');
  int length = last - first - 1;

  string tmp = contents.Substring(first, length);
  last = first + tmp.LastIndexOf('}');
  first = first + tmp.IndexOf('{') + 1;
  length = last - first - 1;

  Write(contents.Substring(0, first));

  foreach (string __type__ in SupportedTypes) {
    string code = contents.Substring(first, length).Replace("ulong", __type__);
    Write(code);
    Write("\n");
  }

  Write(contents.Substring(last));
#>

