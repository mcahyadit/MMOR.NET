<#@ template hostspecific="true" #>
<#@ output extension="cs" #>
<#@ import namespace="System.IO" #>
<#@ import namespace="System.Collections.Generic" #>
// <auto-generated/>

<#
  string original_path = this.Host.ResolvePath("OpAssign.cs");
  string kOrgFuncName = "Add";
  string kOrgFuncSymb = "+= ";
  KeyValuePair<string, string[]>[] kTypeOpMap = new KeyValuePair<string, string[]>[] {
    new ( "Add@+= ", new string[] { "long", "uint", "int", "ushort", "short", "byte", "sbyte", "double", "float" } ),
    new ( "Sub@-= ", new string[] { "ulong", "long", "uint", "int", "ushort", "short", "byte", "sbyte", "double", "float" } ),
    new ( "Xor@|= ", new string[] { "ulong", "long", "uint", "int", "ushort", "short", "byte", "sbyte" } ),
    new ( "Or@|= ", new string[] { "ulong", "long", "uint", "int", "ushort", "short", "byte", "sbyte" } ),
    new ( "And@&= ", new string[] { "ulong", "long", "uint", "int", "ushort", "short", "byte", "sbyte" } ),
    new ( "AndNot@&= ~", new string[] { "ulong", "long", "uint", "int" } ),
    new ( "Mul@*= ", new string[] { "ulong", "long", "uint", "int", "ushort", "short", "double", "float" } ),
  };
  string contents = File.ReadAllText(original_path);

  int first = contents.IndexOf('{') + 1;
  int last = contents.LastIndexOf('}');
  int length = last - first - 1;

  string tmp = contents.Substring(first, length);
  last = first + tmp.LastIndexOf('}');
  first = first + tmp.IndexOf('{') + 1;
  length = last - first - 1;

  Write(contents.Substring(0, first));

  foreach ((string key, string[] __types) in kTypeOpMap) {
    string code = contents.Substring(first, length);
    string[] op = key.Split('@');
    code = code.Replace(kOrgFuncName, op[0]);
    code = code.Replace(kOrgFuncSymb, op[1]);
    foreach (string __type in __types) {
      string code_type = code.Replace("ulong", __type);
      Write(code_type);
      Write("\n");
    }
  }

  Write(contents.Substring(last));
#>

